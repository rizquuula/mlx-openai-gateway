# Qwen3.8-27B-Uncensored at 4-bit, served from a local directory.
#
# Plain KEY=value lines only. No `export`, no $expansion, no quotes.
# bash sources this file, but core/bench.py parses it by splitting on the
# first "=", so anything fancier reaches the engine and the benchmark as two
# different values.

# The id the engine reports at /v1/models and matches every request against.
# Keep it relative: the scripts run from the repo root, and absolutising it
# changes the id that every client has to send.
MLX_MODEL=models/Qwen3.8-27B-Uncensored-MLX

# Download source for core/fetch.sh.
MODEL_REPO=orcarouter/Qwen3.8-27B-Uncensored-MLX

# MODEL_DIR repeats MLX_MODEL here on purpose. MODEL_DIR is where the download
# lands; MLX_MODEL is the id clients send. They are the same string only
# because this profile serves from disk. A profile that serves a bare repo id
# leaves MODEL_DIR empty and they differ.
MODEL_DIR=models/Qwen3.8-27B-Uncensored-MLX

# Pin a commit to freeze the weights. Defaults to main.
# MODEL_REVISION=main

# Context and concurrency knobs. Empty is what this machine can run.
#
# An empty value is meaningful, not decorative. core/serve.sh tests each knob
# with -n, so MLX_KV_BITS= shadows an MLX_KV_BITS=8 left behind in .env and
# turns the flag back off. Delete the line and .env wins again.
MLX_MAX_KV_SIZE=
MLX_KV_BITS=
MLX_MAX_NUM_SEQS=

# Speculative decoding. Empty = off.
MLX_DRAFT_MODEL=
MLX_DRAFT_KIND=dflash
