# Ornith-1.5-9B at 8-bit, served from a local directory.
#
# Plain KEY=value lines only. No `export`, no $expansion, no quotes.
# bash sources this file, but core/bench.py parses it by splitting on the
# first "=", so anything fancier reaches the engine and the benchmark as two
# different values.

# The id the engine reports at /v1/models and matches every request against.
# Keep it relative: the scripts run from the repo root, and absolutising it
# changes the id that every client has to send.
MLX_MODEL=models/Ornith-1.5-9B-MLX-8bit

# Download source for core/fetch.sh.
MODEL_REPO=ornith-ai/Ornith-1.5-9B-MLX-8bit

# This repo ships one build, so a bare repo id would load it correctly. The
# profile still names files and a local directory for two reasons. First,
# core/fetch.sh resumes a dropped shard by byte range, and the two shards here
# are 9.54 GB together. Second, the 8-bit and the 4-bit build need distinct
# ids, so the engine hot-swaps between them for a benchmark without ambiguity.
#
# MODEL_DIR repeats MLX_MODEL here on purpose. MODEL_DIR is where the download
# lands; MLX_MODEL is the id clients send.
MODEL_DIR=models/Ornith-1.5-9B-MLX-8bit

# Pin a commit to freeze the weights. Defaults to main.
# MODEL_REVISION=main

# Context and concurrency knobs. Empty is what this machine can run.
#
# An empty value is meaningful, not decorative. core/serve.sh tests each knob
# with -n, so MLX_KV_BITS= shadows an MLX_KV_BITS=8 left behind in .env and
# turns the flag back off. Delete the line and .env wins again.
MLX_MAX_KV_SIZE=
MLX_KV_BITS=
MLX_MAX_NUM_SEQS=

# Speculative decoding. Empty = off.
MLX_DRAFT_MODEL=
MLX_DRAFT_KIND=dflash

# Serve this model with mlx_lm, not mlx_vlm. The checkpoint declares a vision
# architecture and keeps the image and video token ids, but it carries no
# vision_config and no vision_tower tensors: all 927 tensors sit under the
# language_model. prefix. mlx_vlm builds a vision tower from defaults and
# aborts with "Missing 393 parameters". mlx_lm loads the same directory and
# generates text correctly.
MLX_ENGINE=lm
