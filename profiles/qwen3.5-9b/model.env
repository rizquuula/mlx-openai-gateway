# Qwen3.5-9B at 4-bit, served straight from Hugging Face.
#
# Plain KEY=value lines only. No `export`, no $expansion, no quotes.
# bash sources this file, but core/bench.py parses it by splitting on the
# first "=", so anything fancier reaches the engine and the benchmark as two
# different values.

# A bare repo id, not a path. This repo ships one build, so mlx_vlm resolves
# the id without dragging in other quantizations, and huggingface_hub caches
# the weights under ~/.cache/huggingface.
MLX_MODEL=mlx-community/Qwen3.5-9B-4bit

# Empty on purpose: nothing to pre-download, so core/fetch.sh has no work.
MODEL_REPO=
MODEL_DIR=

# Context and concurrency knobs. Empty is what this machine can run.
#
# An empty value is meaningful, not decorative. core/serve.sh tests each knob
# with -n, so MLX_KV_BITS= shadows an MLX_KV_BITS=8 left behind in .env and
# turns the flag back off. Delete the line and .env wins again.
MLX_MAX_KV_SIZE=
MLX_KV_BITS=
MLX_MAX_NUM_SEQS=

# Speculative decoding. Empty = off. z-lab/Qwen3.5-9B-DFlash is the drafter
# this model was benchmarked with; see NOTES.md before you turn it on.
MLX_DRAFT_MODEL=
MLX_DRAFT_KIND=dflash
