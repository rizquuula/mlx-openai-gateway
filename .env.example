# Copy to .env. Everything here is optional.
#
# Model settings do not live here any more. Each model owns a folder under
# profiles/, and profiles/<name>/model.env holds MLX_MODEL and the tuning
# knobs. See "Profiles" in README.md.
#
# Both ports bind 127.0.0.1, so auth is off by default. Set a key only if you
# expose a port beyond loopback. Generate one with: openssl rand -hex 32

# Client keys for the gateway, comma-separated. Empty = no auth.
GATEWAY_API_KEYS=

# Key the gateway presents to the engine. Empty = no auth.
# Required if you change MLX_BIND away from 127.0.0.1.
MLX_ENGINE_API_KEY=

# Which profile the scripts load. profiles/default names it, and an argument or
# an exported variable overrides that for one run:
#   ./serve-host.sh qwen3.5-9b
#   MLX_PROFILE=qwen3.5-9b ./serve-host.sh
#   ./fetch-model.sh qwen3.8-27b-uncensored
#
# MLX_PROFILE in this file does nothing. The scripts pick the profile first and
# read .env second, so a value here arrives too late to be read.

# Port the gateway listens on, bound to 127.0.0.1.
GATEWAY_PORT=8000

# Where the host-native MLX engine listens.
MLX_UPSTREAM_URL=http://host.docker.internal:8080

# Generation can be slow on a long prompt. Raise if you stream long outputs.
GATEWAY_TIMEOUT_SECONDS=600

# 32 MB. Vision requests carry base64 images inline.
GATEWAY_MAX_BODY_BYTES=33554432

# Set to "on" to restore chain-of-thought. Costly; see README.
# This is a preference, not a model setting, so it stays out of the profiles.
MLX_THINKING=off

# Which engine serves the model: "vlm" or "lm". Default is vlm, which serves
# text and images. Use lm for a text-only build that carries no vision tower,
# where mlx_vlm aborts on missing parameters. The lm engine supports no engine
# API key, so core/serve.sh refuses to start when MLX_ENGINE_API_KEY is set.
# This is a model setting, so it normally lives in profiles/<name>/model.env.
MLX_ENGINE=vlm
