# Build context is ./core/gateway, set by docker-compose.yml. This file must
# live here, not at the repo root, or Docker ignores it.

# Never ship secrets into an image layer.
.env
.env.*
*.pem
*.key

# Python caches. These bloat layers and invalidate the build cache.
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Local environments never belong in the image.
.venv/
venv/

# The image installs from requirements.txt; it does not need these.
Dockerfile
.dockerignore
*.md
tests/

# Version control and editor state
.git/
.gitignore
.vscode/
.idea/
*.swp

# macOS
.DS_Store
._*
